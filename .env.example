# Environment Variables — CTQ Audit RQC
# Copy this file to .env and fill in actual values.
# NEVER commit .env to version control.

# ──────────────────────────────────────────────────
# App
# ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ──────────────────────────────────────────────────
# Database (PostgreSQL 16)
# ──────────────────────────────────────────────────
DATABASE_URL=postgresql://ctqaudit:ctqaudit_pass@localhost:5432/ctqaudit_db?schema=public

# ──────────────────────────────────────────────────
# JWT Authentication
# ──────────────────────────────────────────────────
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_MIN_64_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_THIS_REFRESH_SECRET_MIN_64_CHARS
JWT_REFRESH_EXPIRES_IN=7d

# ──────────────────────────────────────────────────
# MinIO / S3-compatible Object Storage
# ──────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=ctqaudit_minio
S3_SECRET_KEY=ctqaudit_minio_secret
S3_BUCKET=ctqaudit
S3_REGION=us-east-1
S3_USE_SSL=false

# ──────────────────────────────────────────────────
# Redis (only when required)
# ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ──────────────────────────────────────────────────
# Quality Calculation
# ──────────────────────────────────────────────────
# Threshold defect rate (decimal) for CAP vs IMMEDIATE_ACTION
# Default: 0.20 = 20%
DEFECT_RATE_THRESHOLD=0.20

# ──────────────────────────────────────────────────
# CORS
# ──────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
# ──────────────────────────────────────────────────
# Web Push (browser notifications for CAP alerts)
# ──────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
# The private key stays on the API only (never NEXT_PUBLIC_). Changing the pair makes
# every phone re-subscribe the next time it opens the app.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@nihonesia.online
